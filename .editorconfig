# Einrueckungskonventionen dieses Repos, damit Werkzeuge sie nicht stillschweigend umschreiben.
#
# Die Werte sind am Bestand gemessen, nicht gesetzt: .cs steht auf Tabs (ueber 10 000 eingerueckte
# Zeilen, keine einzige mit Leerzeichen — so schreibt der Godot-Editor generierte Skripte), Markdown
# auf Leerzeichen (rund 1 600 gegen 65).
#
# ACHTUNG, diese Datei loest das CLAUDE.md-Problem NICHT: `godot --headless --import` schreibt in
# CLAUDE.md reproduzierbar fuehrende Leerzeichen in Tabs um und beachtet dabei keine .editorconfig
# (gemessen: zwei Laeufe, identisches Ergebnis; `dotnet build` und der Smoke-Test tun es nicht, andere
# .md-Dateien sind nicht betroffen). Siehe den Hinweis dazu in CLAUDE.md unter "Build & Run".
#
# Bewusst knapp gehalten: nur Einrueckung. Regeln wie trim_trailing_whitespace oder end_of_line wuerden
# beim naechsten Speichern ganze Dateien umschreiben — also genau die Art von unbeabsichtigter Aenderung,
# die diese Datei verhindern soll. In Markdown sind zwei Leerzeichen am Zeilenende ausserdem ein
# bedeutungstragender Umbruch.

root = true

# C#: Tabs. Godot erzeugt seine Skripte so; eine Umstellung wuerde jede Datei anfassen.
[*.cs]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.csproj]
indent_style = space
indent_size = 2

# Godot-eigene Formate schreibt der Editor selbst — nicht hineinreden.
[*.{tscn,tres,godot,import,uid}]
indent_style = unset
indent_size = unset
