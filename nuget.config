<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Der Godot-Client bezieht Conspiratio.Lib vom offiziellen NuGet-Feed (nuget.org).
    <clear/> verwirft eventuelle geerbte Feeds (z. B. einen lokalen Lib-Feed aus der
    benutzerweiten NuGet.Config), damit der Build bei allen Mitwirkenden reproduzierbar ist.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
